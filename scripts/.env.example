# The token is the ONLY thing that belongs in this file, and even here it is the
# fallback. Prefer the macOS keychain, which is encrypted at rest and keeps the
# value out of your shell history and off your disk in plaintext:
#
#     security add-generic-password -U -s canvas-api-token -a "$USER" -w
#
# (the prompt shows nothing as you paste; press Return when done)
#
# Everything else -- your Canvas host, course id, rounds, thresholds -- lives in
# course.yml. Copy course.example.yml to start.
#
# Canvas -> Account -> Settings -> Approved Integrations -> + New Access Token
# Set an expiry date. Needs teacher rights on the course.
CANVAS_TOKEN=paste_token_here
